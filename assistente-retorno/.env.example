# Copie para .env.local e ajuste. Nunca versione chaves reais.

# Caminho do banco SQLite (padrão: ./data/assistente.db)
# DATABASE_PATH=./data/assistente.db

# Cria as contas e dados FICTÍCIOS de demonstração quando o banco está vazio (padrão: true).
# Use "false" em qualquer ambiente com dados reais.
# SEED_DEMO=true

# IA para sugestão de mensagens (opcional). Sem a chave, o sistema usa o modo demonstrativo.
# A chave é lida apenas no servidor; nunca é enviada ao navegador.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# AI_PROVIDER=demo   # força o modo demonstrativo mesmo com chave configurada

# Somente para testar "next start" via http em rede local (cookies sem flag Secure). Não use em produção.
# INSECURE_COOKIES=true
