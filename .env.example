# =====================================================================
# CobroSeguro — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e cadastre as mesmas na Vercel.
# NUNCA coloque chaves secretas em variáveis que começam com NEXT_PUBLIC_
# (essas vão para o navegador).
# =====================================================================

# URL pública do app, sem barra no final.
# Local: http://localhost:3000 | Produção: https://seu-dominio.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Project Settings → API) --------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública "anon" (pode ir ao navegador; o RLS protege os dados)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave "service_role" — SECRETA, só no servidor. Ignora o RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Segurança ---------------------------------------------------------
# Chave para criptografar os tokens do Mercado Pago (32 bytes em base64).
# Gere com:  openssl rand -base64 32
# ATENÇÃO: se trocar esta chave, os vendedores precisam reconectar o Mercado Pago.
TOKEN_ENCRYPTION_KEY=
# E-mail que acessa o painel /admin
ADMIN_EMAIL=
# Segredo dos cron jobs (a Vercel envia "Authorization: Bearer <CRON_SECRET>").
# Gere com:  openssl rand -hex 32
CRON_SECRET=

# --- Mercado Pago (Developers → Suas integrações → sua aplicação) ------
# "Client ID" / "App ID" e "Client Secret" da aplicação (credenciais de PRODUÇÃO
# da aplicação são usadas no OAuth; os vendedores de teste usam contas de teste).
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# "Assinatura secreta" da seção Webhooks da aplicação
MP_WEBHOOK_SECRET=
# URL de autorização do OAuth (México). Só mude se a documentação indicar outra.
MP_AUTH_URL=https://auth.mercadopago.com.mx/authorization
# true = pede tokens de teste no OAuth (parâmetro test_token). Deixe false em produção.
MP_OAUTH_TEST_TOKEN=false
# Só para testes locais com servidor falso. Em produção NÃO defina.
# MP_API_URL=

# --- WhatsApp ----------------------------------------------------------
# "manual" (padrão): botões que abrem o WhatsApp com a mensagem pronta.
# "cloud_api": envio automático pela API oficial da Meta (precisa das 2 variáveis abaixo).
MESSAGING_MODE=manual
# Token permanente de um "System User" do Meta Business (SECRETO)
WHATSAPP_TOKEN=
# "Phone number ID" (WhatsApp → API Setup)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_LANG=es_MX

# --- Assinatura --------------------------------------------------------
# Provedor de cobrança da assinatura: "manual" (você ativa no /admin).
BILLING_PROVIDER=manual
# WhatsApp de suporte exibido ao vendedor para ativar a assinatura (ex.: 5215512345678)
NEXT_PUBLIC_SUPPORT_WHATSAPP=
